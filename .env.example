# Meterless Nightshift Configuration (NVIDIA Nemotron LLM runtime)
METERLESS_BASE_URL=https://runtime.meterless.ai/v1
METERLESS_RUNTIME_TOKEN=your_meterless_runtime_token_here
METERLESS_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Zetaris Federated Data Layer Configuration
ZETARIS_API_KEY=your_zetaris_api_key_here
ZETARIS_ORG_ID=1
ZETARIS_BASE_URL=http://localhost:8888/api/v1.0

# Optional Gemini Fallback
GEMINI_API_KEY=your_gemini_api_key_here

