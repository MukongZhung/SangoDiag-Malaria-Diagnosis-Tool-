# Copy to .env (never commit .env). Every value here is read from the environment.

# --- Power layer: Meterless Nightshift (OpenAI-compatible) -----------------------
# Default local runtime. Any pasted form is accepted (host:port, /v1, /v1/chat/completions).
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
# The runtime token Nightshift writes to <stateDir>/proxy-token (shown in its Console).
METERLESS_RUNTIME_TOKEN=
# Lanes. Pin Nemotron routes so the NVIDIA evidence is unambiguous; use meterless/fast and
# meterless/deep instead if you prefer to let Nightshift route.
METERLESS_MODEL_FAST=nvidia/nemotron-3.5-lightning-30b-a3b
METERLESS_MODEL_DEEP=nvidia/nemotron-3-super-120b-a12b
# If Nightshift answers 404 "Function not found for account" for Super, use nvidia/nemotron-3-ultra-550b-a55b.
# Nemotron reasons before its first token; Nightshift stops a cloud lane after 45 s by default.
METERLESS_TTFB_MS=240000
# The NVIDIA API key does NOT go here. Add it in Nightshift under Setup > Providers.

# --- Data layer: Zetaris (local Docker install) ----------------------------------
ZETARIS_BASE_URL=http://localhost:8888/api/v1.0
# Create it yourself in the Zetaris web UI (http://localhost:3000). Never ask an agent to fetch it.
ZETARIS_API_KEY=
ZETARIS_ORG_ID=1
# Table names as registered in Zetaris (e.g. malaria_s3.patients). Defaults match the CSV names.
ZETARIS_TABLE_PATIENTS=patients
ZETARIS_TABLE_VISITS=clinical_visits
ZETARIS_TABLE_EPI=regional_epidemiology

# --- Vision layer (optional) -----------------------------------------------------
# Smear model endpoint: POST multipart "image" -> {"parasite_present": bool, "confidence": float}
VISION_ENDPOINT_URL=

# --- Build layer: Meterless H-MEM ------------------------------------------------
# Local SQLite file that holds patient memory. Stays on this device.
H_MEM_DB=h_mem.db
